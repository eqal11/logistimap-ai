# Backend-only settings. Never place credentials in VITE_* variables.
# Keep fixture mode until integrate_db.py --apply --activate succeeds.
DATA_MODE=fixture
DATABASE_HOST=YOUR_SESSION_POOLER_HOST
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=YOUR_DATABASE_USER
DATABASE_PASSWORD=''
DATABASE_SSL_MODE=require
# Alternative complete URL is supported, but split fields avoid manual URL encoding.
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173"]
REQUEST_LIMIT_PER_MINUTE=120

# Phase 2 public providers: local workspace access only; no frontend credentials.
DISCOVERY_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOCODING_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT="LogistiMapAI/0.3 (local Malaysian industrial GIS research)"

# Phase 3 routing: public demo only for bounded local interactive use.
ROUTING_ENABLED=true
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-car
ROUTING_OSRM_PROFILE=driving
ROUTING_PROVIDER_LABEL="FOSSGIS public demo"
ROUTING_POLICY_URL=https://routing.openstreetmap.de/about.html

# Phase 4 local spatial processing and saved history (disabled in deployment).
ANALYTICS_ENABLED=true

# Phase 5 bounded local optimization only; disable on public deployment.
OPTIMIZATION_ENABLED=true

# Phase 7: deterministic mode works with no key. Backend-only optional tool planner.
GEOAI_ENABLED=true
GEOAI_PROVIDER=disabled
GEOAI_BASE_URL=https://api.openai.com/v1
GEOAI_MODEL=
GEOAI_API_KEY=
GEOAI_TIMEOUT_S=25
